# App Settings
ENV=development
PORT=8000
DEBUG=true

# OpenAI-compatible LLM (required for agent pipeline)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=empty
LLM_MAX_TOKENS=40000
LLM_TEMPERATURE=0.2

# MySQL (primary runtime database — URL-encode special chars in password, e.g. @ → %40):
# Local: DATABASE_URL=mysql+asyncmy://root:<password>@localhost:3307/constructaiq?charset=utf8mb4
# Remote: DATABASE_URL=mysql+asyncmy://backenduser:<password>@217.18.55.123:3306/constructaiq?charset=utf8mb4
# One-time SQL Server source for migrate_mssql_to_mysql.py (remove after ETL):
# SOURCE_DATABASE_URL=mssql+aioodbc://@localhost/hackathon?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Trusted_Connection=yes&Server=(localdb)%5CMSSQLLocalDB
DATABASE_URL=
SOURCE_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Azure Communication Services Email (optional — intelligence report delivery)
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
AZURE_COMMUNICATION_EMAIL_FROM=DoNotReply@<verified-domain>
AZURE_COMMUNICATION_EMAIL_REPLY_TO=support@constructaiq.com
REPORT_EMAIL_ENABLED=false
FRONTEND_BASE_URL=http://localhost:5173
REPORT_EMAIL_RATE_LIMIT_MINUTES=60

