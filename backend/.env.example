# App Settings
ENV=development
PORT=8000
DEBUG=true

# Azure Document Intelligence (optional — used for Mode 2 document uploads)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-key>

# Azure AI Foundry REST Endpoint (required)
AZURE_AIFOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project>/openai/v1/responses
AZURE_AIFOUNDRY_KEY=<your-key>
