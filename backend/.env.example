# App Settings
ENV=development
PORT=8000
DEBUG=true

# Azure Document Intelligence (optional — used for Mode 2 document uploads)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-key>

# Azure AI Foundry REST Endpoint (required)
AZURE_AIFOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project>/openai/v1/responses
AZURE_AIFOUNDRY_KEY=<your-key>

# Azure Blob Storage (optional — omit to keep in-memory document extraction)
# Create a private blob container in Azure Portal, then paste the connection string here.
# Document Intelligence reads uploaded PDFs via short-lived read SAS URLs.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=constructaiq-documents
AZURE_STORAGE_SAS_EXPIRY_MINUTES=60

# Azure SQL Database (optional — omit to run without persistence)
# Requires ODBC Driver 18 for SQL Server on the host machine.
# URL-encode special characters in the password (@, #, %, etc.).
# Add your client IP to the Azure SQL server firewall before connecting.
DATABASE_URL=mssql+aioodbc://<user>:<password>@<server>.database.windows.net:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Azure Communication Services Email (optional — intelligence report delivery)
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
AZURE_COMMUNICATION_EMAIL_FROM=DoNotReply@<verified-domain>
AZURE_COMMUNICATION_EMAIL_REPLY_TO=support@constructaiq.com
REPORT_EMAIL_ENABLED=false
FRONTEND_BASE_URL=http://localhost:5173
REPORT_EMAIL_RATE_LIMIT_MINUTES=60

