# App Settings
ENV=development
PORT=8000
DEBUG=true

# Azure Document Intelligence (optional — used for Mode 2 document uploads)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-key>

# Azure AI Foundry REST Endpoint (required)
AZURE_AIFOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project>/openai/v1/responses
AZURE_AIFOUNDRY_KEY=<your-key>

# Azure SQL Database (optional — omit to run without persistence)
# Requires ODBC Driver 18 for SQL Server on the host machine.
# URL-encode special characters in the password (@, #, %, etc.).
# Add your client IP to the Azure SQL server firewall before connecting.
DATABASE_URL=mssql+aioodbc://<user>:<password>@<server>.database.windows.net:1433/<database>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
